// SQLite schema for local development
// For PostgreSQL production schema, see schema.postgresql.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String?
  firstName             String
  lastName              String
  phone                 String?
  googleId              String?               @unique
  avatar                String? // profile image path, e.g. /uploads/avatar-xxx.jpg
  role                  String                @default("USER") // "USER" | "HOST" | "ADMIN"
  suspended             Boolean               @default(false) // admin-disabled: blocks login + hides host listings
  bankName              String? // Host bank name (e.g. "KCB Bank")
  bankAccountNo         String? // Host 10-digit Kenyan account number
  bankCode              String? // Paystack bank code (e.g. "011")
  payoutMethod          String? // "bank" | "mpesa"
  mpesaPhone            String? // Paystack local format, e.g. "0712345678"
  paystackRecipientCode String? // Reusable Paystack transfer recipient
  paystackRecipientKey  String? // Hash of destination details used by that recipient
  payoutFrequency       String? // "weekly" | "biweekly" | "monthly"
  deletedAt             DateTime? // account erased; row retained only for legal/financial relations
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  bookings              Booking[]
  reviews               Review[]
  favorites             Favorite[]
  messages              Message[]
  properties            Property[]
  payouts               Payout[]
  wallet                HostWallet?
  pushSubscriptions     PushSubscription[]
  shortlists            Shortlist[]
  conversationMessages  ConversationMessage[]
  consentRecords        ConsentRecord[]
  hostApplication       HostApplication?
  identityVerification  IdentityVerification?
  disputesRaised        Dispute[]
  refreshSessions       RefreshSession[]
}

// Server-side record of an issued refresh token. Enables rotation on every
// refresh, reuse detection (a rotated token presented again after the grace
// window revokes the user's sessions), and immediate revocation on logout -
// all impossible with a bare JWT that cannot be invalidated before expiry.
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique // sha256 of the opaque refresh token
  previousHash String?   // hash of the token this session rotated FROM, for reuse detection
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// Durable, non-PII audit trail for self-service and staff-initiated erasure.
// IDs are intentionally not foreign keys because the target may be hard-deleted.
model AccountErasureLog {
  id           String   @id @default(cuid())
  targetUserId String
  actorId      String
  actorRole    String
  path         String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([actorId])
}

// A prospective host's application to become a HOST. Registering with role HOST
// only expresses intent: the user is created as USER with a DRAFT application
// here, and the HOST role is granted (User.role) only on admin approval.
// Lifecycle status: "DRAFT" | "SUBMITTED" | "CHANGES_REQUESTED" | "APPROVED" | "REJECTED".
// Verification documents are stored separately as AES-GCM encrypted bytes.
model HostApplication {
  id                    String                    @id @default(cuid())
  userId                String                    @unique // one application per user
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String                    @default("DRAFT")
  // Applicant-entered business / contact / hosting details for later verification
  legalName             String?
  businessName          String? // trading name (individual hosts allowed)
  businessType          String? // "individual" | "company"
  contactPhone          String?
  contactEmail          String?
  dateOfBirth           String? // YYYY-MM-DD; validated as adult before submission
  nationality           String?
  identityType          String? // NATIONAL_ID | PASSPORT | ALIEN_ID
  kraPin                String?
  companyRegistrationNo String?
  city                  String? // primary city/area they host in
  propertyCount         Int? // number of units they plan to list
  propertyRelationship  String? // OWNER | MANAGER | AGENT | TENANT
  propertyTypesJson     String? // JSON array of intended listing types
  propertyLocations     String?
  yearsHosting          Int?
  preferredPayoutMethod String? // bank | mpesa
  experience            String? // hosting background / notes for verification
  agreedTerms           Boolean                   @default(false)
  reviewNote            String? // applicant-visible reviewer note (reason for changes/rejection)
  reviewedBy            String? // audit: admin userId who last reviewed (no relation, like Payout.initiatedBy)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  documents             HostApplicationDocument[]
  auditLogs             HostApplicationAudit[]

  @@index([status])
}

model HostApplicationDocument {
  id            String          @id @default(cuid())
  applicationId String
  application   HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String
  originalName  String
  mimeType      String
  size          Int
  ciphertext    Bytes
  iv            Bytes
  authTag       Bytes
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([applicationId, kind])
  @@index([applicationId])
}

model HostApplicationAudit {
  id            String          @id @default(cuid())
  applicationId String
  application   HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  action        String
  note          String?
  createdAt     DateTime        @default(now())

  @@index([applicationId, createdAt])
}

model Property {
  id                String           @id @default(cuid())
  hostId            String? // user who owns/manages this property
  host              User?            @relation(fields: [hostId], references: [id])
  title             String
  location          String
  // Listing publication lifecycle - independent of the host's own account
  // verification (User.role/HostApplication). A host may hold and edit drafts
  // regardless of their own verification status; only submitting for review and
  // going live require an APPROVED HostApplication (see property.service.ts).
  // "DRAFT" | "PENDING_REVIEW" | "PUBLISHED" | "REJECTED" | "SUSPENDED"
  status            String           @default("DRAFT")
  listingReviewNote String? // applicant-visible reason for reject/suspend
  listingReviewedBy String? // admin userId who last reviewed this listing
  submittedAt       DateTime? // when the host submitted this listing for review
  listingReviewedAt DateTime?
  price             Int // fallback / base nightly price
  price1Bed         Int? // nightly price for 1-bed option
  price2Bed         Int? // nightly price for 2-bed option
  bathrooms1Bed     Int? // bathroom count for 1-bed listing
  bathrooms2Bed     Int? // bathroom count for 2-bed listing
  rating            Float            @default(0)
  reviews           Int              @default(0)
  bedrooms          Int
  bathrooms         Int
  area              Int
  neighborhood      String? // Kilimani | Westlands | Karen | Gigiri | Lavington
  lat               Float? // map coordinate
  lng               Float? // map coordinate
  description       String
  imagesJson        String           @default("[]") // JSON array of image URLs
  amenitiesJson     String           @default("[]") // JSON array
  nearbyJson        String           @default("[]") // JSON array
  type              String // "apartment" | "studio" | "penthouse"
  available         Boolean          @default(true)
  featured          Boolean          @default(false)
  icalToken         String?          @unique // token for the outbound iCal feed URL
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  bookings          Booking[]
  calendarSources   CalendarSource[]
  calendarBlocks    CalendarBlock[]
  priceRules        PriceRule[]
  guestReviews      Review[]
  favoritedBy       Favorite[]
  shortlistItems    ShortlistItem[]
  addOns            PropertyAddOn[]

  @@index([hostId])
  @@index([status])
}

// External iCal feeds (Airbnb, Booking.com, VRBO, ...) imported per property
model CalendarSource {
  id           String          @id @default(cuid())
  propertyId   String
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String // "Airbnb", "Booking.com", ...
  url          String // external iCal/ICS URL
  lastSyncedAt DateTime?
  lastStatus   String? // "OK (n events)" | "ERROR: ..."
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  blocks       CalendarBlock[]
}

// Blocked date ranges: imported from a CalendarSource, or created manually by admin
model CalendarBlock {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceId   String? // null = manual block
  source     CalendarSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  uid        String? // iCal UID for dedupe
  summary    String?
  start      DateTime
  end        DateTime
  createdAt  DateTime        @default(now())

  @@index([propertyId])
  @@index([sourceId])
}

// Seasonal / date-range nightly price overrides; base Property.price is the fallback
model PriceRule {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String? // "Peak season", "Weekends", ...
  start      DateTime
  end        DateTime
  price      Int // nightly price override (KES)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId])
}

model Booking {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id])
  propertyId           String
  property             Property        @relation(fields: [propertyId], references: [id])
  checkIn              DateTime
  checkOut             DateTime
  guests               Int
  bedOption            String? // "1bed" | "2bed"
  checkInTime          String?
  checkOutTime         String? // requested check-out "HH:MM"; later than 10:00 AM adds late fee
  specialRequests      String?
  additionalGuestsJson String? // JSON array of extra guests [{firstName,lastName}]
  paymentMethod        String // "card" | "mpesa" | "bank"
  status               String          @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED" | "CONFLICT"
  subtotal             Int
  cleaningFee          Int             @default(1500)
  serviceFee           Int
  lateCheckoutFee      Int             @default(0)
  promoCodeId          String?
  promoCode            PromoCode?      @relation(fields: [promoCodeId], references: [id])
  discountAmount       Int             @default(0)
  total                Int
  paymentReference     String?         @unique // Paystack transaction reference
  paymentChannel       String? // Actual channel from Paystack (card, mobile_money)
  paymentGateway       String? // "paystack" or null
  paidAt               DateTime? // When payment was confirmed
  hostNetAmount        Int? // What the host actually earns from this booking
  withholdingTax       Int? // KRA withholding tax amount (5% of host gross)
  cancelledAt          DateTime? // When the booking was cancelled
  cancelledBy          String? // Who cancelled: "GUEST" | "ADMIN" | "SYSTEM"
  cancelledById        String? // userId of the canceller (GUEST/ADMIN)
  refundStatus         String? // Paid bookings cancelled after payment: "REFUND_PENDING" | "REFUNDED" | "REFUND_DECLINED"
  refundedAt           DateTime?
  refundedBy           String? // admin userId who resolved the refund
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  review               Review?
  payoutBookings       PayoutBooking[]
  addOns               BookingAddOn[]
  conversation         Conversation?
  disputes             Dispute[]

  // Hot query paths: availability overlap checks (property + window), a user's
  // booking history, and status-filtered admin/host lists.
  @@index([propertyId, checkIn])
  @@index([userId, createdAt])
  @@index([status])
  @@index([refundStatus])
}

// Guest-facing identity verification, separate from the host's own
// HostApplication (which already carries a host's KYC identity documents).
// Every account - regardless of role - may hold one of these; it gates
// payment on a booking (see payment.service.assertIdentityVerified), not
// dashboard or draft-listing access.
// Lifecycle: "UNVERIFIED" | "SUBMITTED" | "APPROVED" | "REJECTED".
model IdentityVerification {
  id          String                         @id @default(cuid())
  userId      String                         @unique
  user        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String                         @default("UNVERIFIED")
  fullName    String?
  dateOfBirth String? // YYYY-MM-DD
  idType      String? // NATIONAL_ID | PASSPORT | ALIEN_ID
  idNumber    String?
  reviewNote  String? // applicant-visible reviewer note
  reviewedBy  String? // admin userId
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  documents   IdentityVerificationDocument[]

  @@index([status])
}

model IdentityVerificationDocument {
  id             String               @id @default(cuid())
  verificationId String
  verification   IdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  kind           String // ID_FRONT | ID_BACK | SELFIE
  originalName   String
  mimeType       String
  size           Int
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([verificationId, kind])
  @@index([verificationId])
}

// A booking-linked dispute between the guest and host, mediated by admin.
// `messages` are visible to both participants and admin; `notes` are
// admin-only and must never be exposed through a participant-facing API.
// Lifecycle: "OPEN" | "UNDER_REVIEW" | "RESOLVED" | "DISMISSED".
model Dispute {
  id           String            @id @default(cuid())
  bookingId    String
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     User              @relation(fields: [raisedById], references: [id])
  raisedByRole String // "GUEST" | "HOST"
  category     String // PROPERTY_CONDITION | PAYMENT | CONDUCT | CANCELLATION | OTHER
  description  String
  status       String            @default("OPEN")
  resolution   String? // participant-visible resolution summary
  resolvedBy   String? // admin userId
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  evidence     DisputeEvidence[]
  messages     DisputeMessage[]
  notes        DisputeNote[]
  auditLogs    DisputeAudit[]

  @@index([bookingId])
  @@index([status])
}

model DisputeEvidence {
  id           String   @id @default(cuid())
  disputeId    String
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy   String // userId (participant or admin)
  originalName String
  mimeType     String
  size         Int
  ciphertext   Bytes
  iv           Bytes
  authTag      Bytes
  createdAt    DateTime @default(now())

  @@index([disputeId])
}

// Messages visible to both the guest and host participants, and admin.
model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String // "GUEST" | "HOST" | "ADMIN"
  body       String
  createdAt  DateTime @default(now())

  @@index([disputeId, createdAt])
}

// Admin-only private notes on a dispute. Never returned to participants.
model DisputeNote {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([disputeId, createdAt])
}

// Full audit trail of actions taken on a dispute (open, evidence, status
// changes, resolution) for accountability of admin mediation.
model DisputeAudit {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actorId   String
  action    String // OPENED | EVIDENCE_ADDED | MESSAGE_SENT | STATUS_CHANGED | RESOLVED | DISMISSED
  note      String?
  createdAt DateTime @default(now())

  @@index([disputeId, createdAt])
}

// Post-stay guest review. `publicComment` is guest-facing text shown on the
// property page; `satisfaction` and `privateNote` are private admin-only signals
// and must never be exposed through public APIs. One review per booking.
model Review {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  rating        Int // 1-5 stars
  publicComment String? // guest-facing review text shown publicly on the property page
  satisfaction  String? // PRIVATE: "happy" | "neutral" | "unhappy" - admin only
  privateNote   String? // PRIVATE: feedback for admin - how to improve - admin only
  hidden        Boolean  @default(false) // admin moderation: hide from public display
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId])
}

// A user's saved/favourited property
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

// In-app messages between a customer and the admin team. All messages with the
// same userId form that customer's conversation thread.
model Message {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderRole  String // "USER" | "ADMIN"
  body        String
  readByAdmin Boolean  @default(false)
  readByUser  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  discountPercent  Int
  maxDiscount      Int?
  minBookingAmount Int?
  validFrom        DateTime
  validUntil       DateTime
  maxUses          Int?
  currentUses      Int       @default(0)
  active           Boolean   @default(true)
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]
}

// Travel guides / blog posts
model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  body       String // HTML content
  coverImage String? // image URL or path
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Web push notification subscriptions
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      String // JSON: { p256dh, auth }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Host running balance of unpaid earnings
model HostWallet {
  id           String    @id @default(cuid())
  hostId       String    @unique
  host         User      @relation(fields: [hostId], references: [id])
  balance      Int       @default(0) // Unpaid earnings in KES
  totalEarned  Int       @default(0) // Lifetime earnings
  totalPaidOut Int       @default(0) // Lifetime payouts
  lastPayoutAt DateTime?
  nextPayoutAt DateTime? // Calculated from frequency + lastPayoutAt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Payout transfer to host's bank account
model Payout {
  id            String          @id @default(cuid())
  hostId        String
  host          User            @relation(fields: [hostId], references: [id])
  amount        Int // Total KES transferred
  transferRef   String?         @unique // Paystack transfer reference
  recipientCode String? // Paystack recipient code
  status        String          @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | REVERSED
  failureReason String?
  initiatedBy   String? // "system" | admin userId
  bookingsCount Int             @default(0) // How many bookings this payout covers
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bookings      PayoutBooking[]

  @@index([hostId])
  @@index([status])
}

// Tracks which bookings are included in which payout
model PayoutBooking {
  id        String  @id @default(cuid())
  payoutId  String
  payout    Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  amount    Int // How much of this booking went into this payout

  @@unique([payoutId, bookingId])
  @@index([bookingId])
}

// Audit log for payment/payout webhooks
model PaymentLog {
  id        String   @id @default(cuid())
  bookingId String?
  event     String // "charge.success", "transfer.success", etc.
  reference String?
  payload   String? // Raw JSON (truncated)
  createdAt DateTime @default(now())
}

// Collaborative property shortlists (shareable collections)
model Shortlist {
  id        String          @id @default(cuid())
  ownerId   String
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  token     String          @unique @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     ShortlistItem[]

  @@index([ownerId])
}

model ShortlistItem {
  id          String    @id @default(cuid())
  shortlistId String
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  note        String?
  addedAt     DateTime  @default(now())

  @@unique([shortlistId, propertyId])
  @@index([shortlistId])
}

model Conversation {
  id        String                @id @default(cuid())
  bookingId String                @unique
  booking   Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AddOn {
  id          String          @id @default(cuid())
  name        String
  description String
  price       Float
  image       String?
  category    String // transport | catering | housekeeping | concierge
  active      Boolean         @default(true)
  properties  PropertyAddOn[]
  bookings    BookingAddOn[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PropertyAddOn {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  addOnId    String
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([propertyId, addOnId])
  @@index([propertyId])
}

model BookingAddOn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  unitPrice Float // snapshot at booking time - price changes must not alter existing bookings

  @@unique([bookingId, addOnId])
  @@index([bookingId])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId     String?
  necessary     Boolean  @default(true)
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  policyVersion String
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([visitorId])
}
