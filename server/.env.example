# Database (provided by Railway PostgreSQL plugin)
DATABASE_URL="postgresql://postgres:password@localhost:5432/zurilofts?schema=public"

# JWT Secrets - use strong random values in production
JWT_ACCESS_SECRET="generate-a-strong-random-secret-here-min-32-chars"
JWT_REFRESH_SECRET="generate-another-strong-random-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
# Production authorized redirect URI should be:
# https://your-production-domain.com/api/auth/google/callback
# In production the server can derive this from Railway/custom-domain headers if
# omitted, but setting it explicitly is still recommended.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Paystack (https://dashboard.paystack.com)
# Webhook signatures (the x-paystack-signature header) are HMAC-SHA512 over the
# raw request body, signed with PAYSTACK_SECRET_KEY. Paystack has no separate
# webhook signing secret, so none is configured here.
PAYSTACK_SECRET_KEY="your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="your_paystack_public_key"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Cloudinary (image storage - required in production)
# Copy the "API Environment variable" from your Cloudinary dashboard.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name"

# Web Push (VAPID) - browser push notifications.
# Generate a keypair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these set, push sends are skipped (logged as a warning) rather than crashing.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Telegram alert bot (optional). Alerts only fire when a token AND chat id are set.
# TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token-from-@BotFather"
# TELEGRAM_CHAT_ID="your-chat-id"

# AES-256 key used to encrypt host identity documents at rest (32+ bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset in dev; set it in production before enabling identity verification.
# HOST_DOCUMENT_ENCRYPTION_KEY="your-32-plus-char-encryption-key"

# Platform fees (all optional: unset uses the default value shown)
# KRA withholding tax, as a percentage of the host's taxable base.
WITHHOLDING_TAX_RATE="5"
TRANSFER_FEE_PASS_TO_HOST="false"
# Share of the accommodation subtotal the platform keeps, charged to the host.
# A fraction: 0.1 is 10%. Never charged on cleaning, extra-guest or late
# check-out amounts, which are pass-through costs the host has to cover.
HOST_COMMISSION_RATE="0.1"
# Guest-side service fee as a fraction of the nightly subtotal. 0 is the
# policy: the guest pays the listed price and the platform is paid from
# HOST_COMMISSION_RATE alone.
GUEST_SERVICE_FEE_RATE="0"
# Pass the guest's cleaning and late check-out fees through to the host.
HOST_PAY_CLEANING_FEE="false"
HOST_PAY_LATE_CHECKOUT_FEE="false"
# Hours after check-in before a host's share becomes withdrawable. Money stays
# on the platform until the stay has started, so a cancellation or dispute
# cannot leave a paid-out host owing a refund back. 0 releases at check-in.
HOST_FUNDS_HOLD_HOURS="24"
# Who funds a promo code: "host" takes the discount out of that host's payout,
# "platform" pays the host in full and absorbs it (except a host's own code).
PLATFORM_PROMO_FUNDING="host"

# Founding-host programme. The first FOUNDING_HOST_LIMIT approved hosts pay
# FOUNDING_HOST_COMMISSION_RATE instead of HOST_COMMISSION_RATE, for as long as
# they host. A limit of 0 (the default) switches the programme off: decide how
# many places to give away before turning it on.
FOUNDING_HOST_LIMIT="0"
FOUNDING_HOST_COMMISSION_RATE="0.05"

# Referral bonus. Whole KES credited to the host who referred another host, paid
# once when that referred host first earns from a released booking. 0 switches
# the bonus off, which is the shipped default. Each approved host is given a
# shareable code automatically.
REFERRAL_REWARD_KES="0"

# Sign-up nudges. An application left untouched for HOST_NUDGE_AFTER_DAYS is
# reminded by push notification, at most HOST_NUDGE_MAX times in total. Set the
# maximum to 0 to switch nudges off.
HOST_NUDGE_AFTER_DAYS="2"
HOST_NUDGE_MAX="2"

# Server
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
