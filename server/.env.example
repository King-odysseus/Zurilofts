# Database (provided by Railway PostgreSQL plugin)
DATABASE_URL="postgresql://postgres:password@localhost:5432/zurilofts?schema=public"

# JWT Secrets - use strong random values in production
JWT_ACCESS_SECRET="generate-a-strong-random-secret-here-min-32-chars"
JWT_REFRESH_SECRET="generate-another-strong-random-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
# Production authorized redirect URI should be:
# https://your-production-domain.com/api/auth/google/callback
# In production the server can derive this from Railway/custom-domain headers if
# omitted, but setting it explicitly is still recommended.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Paystack (https://dashboard.paystack.com)
# Webhook signatures (the x-paystack-signature header) are HMAC-SHA512 over the
# raw request body, signed with PAYSTACK_SECRET_KEY. Paystack has no separate
# webhook signing secret, so none is configured here.
PAYSTACK_SECRET_KEY="your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="your_paystack_public_key"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Cloudinary (image storage - required in production)
# Copy the "API Environment variable" from your Cloudinary dashboard.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name"

# Web Push (VAPID) - browser push notifications.
# Generate a keypair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these set, push sends are skipped (logged as a warning) rather than crashing.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Telegram alert bot (optional). Alerts only fire when a token AND chat id are set.
# TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token-from-@BotFather"
# TELEGRAM_CHAT_ID="your-chat-id"

# AES-256 key used to encrypt host identity documents at rest (32+ bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset in dev; set it in production before enabling identity verification.
# HOST_DOCUMENT_ENCRYPTION_KEY="your-32-plus-char-encryption-key"

# Platform fees
SERVICE_FEE_PERCENT="7.5"
WITHHOLDING_TAX_RATE="5"
TRANSFER_FEE_PASS_TO_HOST="false"

# Server
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
